VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase Edge Function secrets. Never expose these through Vite.
BRAVE_SEARCH_API_KEY=
RIPPLE_CRON_SECRET=
OPENAI_API_KEY=
RIPPLE_RESEARCH_MODEL=gpt-5-mini
# All zero/blank AI budget settings intentionally pause NLP processing.
RIPPLE_AI_MONTHLY_BUDGET_USD=0
RIPPLE_AI_MAX_CASE_RESERVATION_USD=0.10
# Set these to the selected model's current API rates, in USD per 1M tokens.
RIPPLE_AI_INPUT_USD_PER_MILLION=0
RIPPLE_AI_OUTPUT_USD_PER_MILLION=0
